generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  username      String          @unique
  passwordHash  String
  createdAt     DateTime        @default(now())
  refreshTokens RefreshToken[]
  characters    UserCharacter[]
  decks         Deck[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCharacter {
  id          String   @id @default(uuid())
  userId      String
  characterId String // catalog id, e.g. "alicent"; validated against the catalog on write, deliberately not a FK
  acquiredAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
}

model Deck {
  id        String     @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots     DeckSlot[]

  @@index([userId])
}

model DeckSlot {
  id          String @id @default(uuid())
  deckId      String
  position    Int // 0..5, stable slot identity for future items; not a play order
  characterId String // catalog id, validated on write, deliberately not a FK
  deck        Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, position])
  @@unique([deckId, characterId])
}
